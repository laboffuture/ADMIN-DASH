# Port the hub listens on (bound to 0.0.0.0)
PORT=5500
# Single admin password for the hub login
ADMIN_PASSWORD=change-me
# Long random string for signing session cookies
# generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-me-too
# Shared secret for module SSO (same value goes into each sso-enabled module's env).
# Modules exchange a 60s hub-signed token for their own session — no passwords stored.
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
HUB_SSO_SECRET=
